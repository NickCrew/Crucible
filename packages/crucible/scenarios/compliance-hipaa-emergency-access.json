{
  "id": "compliance-hipaa-emergency-access",
  "name": "HIPAA Emergency Access (Break Glass) Abuse",
  "category": "Compliance",
  "difficulty": "Advanced",
  "description": "Tests the enforcement of justification and alerting for emergency access to PHI.",
  "rule_ids": ["164.312-a-1"],
  "tags": ["hipaa", "access-control", "healthcare", "emergency-access"],
  "compliance": {
    "mappings": [
      {
        "framework": "hipaa",
        "citation": "164.312(a)(1)",
        "safeguard": "access-control",
        "evidenceTypes": ["request-response", "audit-log"],
        "assertion": "emergency-access-requires-justification",
        "rationale": "Emergency access probes collect evidence that PHI access is constrained by authorization and justification requirements.",
        "implementationStatus": "implemented",
        "endpoint": {
          "method": "POST",
          "path": "/api/v1/healthcare/records/emergency-access"
        },
        "evidence": [
          {
            "type": "request-response",
            "stepId": "emergency-access-no-justification",
            "description": "Emergency PHI access without justification should be blocked."
          },
          {
            "type": "audit-log",
            "stepId": "emergency-access-with-justification",
            "description": "Justified emergency access should remain attributable and reviewable."
          }
        ]
      }
    ]
  },
  "steps": [
    {
      "id": "emergency-access-no-justification",
      "name": "Emergency Access Attempt without Justification",
      "stage": "exploitation",
      "request": {
        "method": "POST",
        "url": "/api/v1/healthcare/records/emergency-access",
        "headers": {
          "Authorization": "Bearer {{provider_token}}",
          "Content-Type": "application/json"
        },
        "body": {
          "patient_id": "P-12345"
        }
      },
      "execution": {
        "delayMs": 500
      },
      "expect": {
        "blocked": true
      }
    },
    {
      "id": "emergency-access-with-justification",
      "name": "Emergency Access with Justification",
      "stage": "exploitation",
      "request": {
        "method": "POST",
        "url": "/api/v1/healthcare/records/emergency-access",
        "headers": {
          "Authorization": "Bearer {{provider_token}}",
          "Content-Type": "application/json"
        },
        "body": {
          "patient_id": "P-12345",
          "justification": "Emergency life-saving procedure required."
        }
      },
      "execution": {
        "delayMs": 1000
      }
    }
  ]
}
