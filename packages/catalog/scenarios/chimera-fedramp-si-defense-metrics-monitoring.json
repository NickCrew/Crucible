          }
        ]
      }
    ]
  },
  "steps": [
    {
      "id": "read-fedramp-defense-metrics",
      "name": "Read FedRAMP Defense Metrics",
      "stage": "evidence",
      "request": {
        "method": "GET",
        "url": "/api/defense/metrics",
        "params": {
          "fedramp": "true"
        }
      },
      "execution": {
        "delayMs": 250
      },
      "expect": {
        "status": 200,
        "bodyContains": "FEDRAMP-RA-5-001"
